# --- Required ---
# PostgreSQL connection string from your deployment provider (never commit a real one).
DATABASE_URL="postgresql://user:password@host:5432/database"
# JWT signing secret. Must be at least 32 characters in production. Never commit a real value.
JWT_SECRET="change-me"
PORT=3000
NODE_ENV=development

# --- CORS ---
# Origin(s) allowed to call the API from browsers (comma-separated for multiple).
# CORS_ORIGIN is an alias accepted in addition to FRONTEND_URL.
#
# Each value must be a BARE ORIGIN: scheme, host and non-default port only. A
# trailing slash is tolerated but unnecessary, and a path, query, fragment or
# embedded credentials are refused at boot. `https://app.example.com` is correct;
# `https://app.example.com/dashboard` is not. The reason to be strict is that a
# malformed value produces no CORS header at all, so the deployed frontend is
# silently refused by every request while the symptom points at the browser.
FRONTEND_URL="http://localhost:3001"
CORS_ORIGIN=""

# --- OpenAPI / Scalar ---
# Overrides the server URL advertised in the OpenAPI document.
# In production set this to the deployed backend, e.g. https://your-backend-domain.com
API_BASE_URL="http://localhost:3000"

# --- Auth ---
JWT_EXPIRES_IN="1d"

# --- Attachments ---
MAX_UPLOAD_SIZE_MB=10
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60