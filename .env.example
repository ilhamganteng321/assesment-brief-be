# --- Required ---
# PostgreSQL connection string from your deployment provider (never commit a real one).
DATABASE_URL="postgresql://user:password@host:5432/database"
# JWT signing secret. Must be at least 32 characters in production. Never commit a real value.
JWT_SECRET="change-me"
PORT=3000
NODE_ENV=development

# --- CORS ---
# Origin(s) allowed to call the API from browsers (comma-separated for multiple).
# CORS_ORIGIN is an alias accepted in addition to FRONTEND_URL; set ONE of the
# two, not both. Either is enough, and in production at least one is required.
#
# Leave the unused one commented out. Do NOT set it to "" : an empty value is
# rejected at boot, because the variable counts as "present but unusable" and
# silently disabling CORS is the one outcome that must not pass unnoticed.
#
# Each value must be a BARE ORIGIN: scheme, host and non-default port only. A
# trailing slash is tolerated but unnecessary, and a path, query, fragment or
# embedded credentials are refused at boot. `https://app.example.com` is correct;
# `https://app.example.com/dashboard` is not. The reason to be strict is that a
# malformed value produces no CORS header at all, so the deployed frontend is
# silently refused by every request while the symptom points at the browser.
FRONTEND_URL="http://localhost:3001"
# CORS_ORIGIN="https://app.example.com"

# --- OpenAPI / Scalar ---
# Overrides the server URL advertised in the OpenAPI document.
# In production set this to the deployed backend, e.g. https://your-backend-domain.com
API_BASE_URL="http://localhost:3000"

# --- Auth ---
JWT_EXPIRES_IN="1d"

# --- Attachments ---
MAX_UPLOAD_SIZE_MB=10
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# --- Invitation email ---
# Which transport sends project invitations.
#
#   log     Prints the whole message to stdout, acceptance link included. This is
#           a deliberate token disclosure and it is how the invitation flow is
#           followed by hand in development, but it is refused at boot when
#           NODE_ENV=production: a live acceptance token in a log sink is a way
#           into somebody else's project for whoever can read it.
#   memory  Records messages in memory and delivers nothing. Convenient for a
#           local run that does not want output noise, and equally refused in
#           production, because a project manager would be told an invitation was
#           sent that no recipient will ever receive.
#   smtp    The only production-legal value. No transport is registered by
#           default, so set this only alongside a call to setEmailService() at
#           startup; without one, the first send fails loudly rather than
#           pretending the mail went out.
#
# Production refuses to boot on `log` or `memory` instead of quietly defaulting
# away from them, so a misconfigured deployment is a failed start rather than a
# feature that looks fine and delivers nothing.
EMAIL_PROVIDER=log
# The From address on an invitation.
MAIL_FROM="no-reply@example.com"

# How long an emailed invitation link stays usable, in days. Capped at 90 by the
# schema: an invitation is a standing grant to join a project, so a leaked inbox
# stays a way in for as long as the link works.
INVITATION_TTL_DAYS=7