{
	"name": "backend",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:integration": "bun run src/integration/assessment.integration.ts",
		"test:suites": "bun run tests/run.ts",
		"verify:clean-database": "bun run scripts/verify-clean-database.ts",
		"verify:seed-logins": "bun run scripts/verify-seed-logins.ts",
		"seed": "bun run src/seed/seed.ts",
		"dbi:show": "prisma db migrate --show",
		"dbi:migrate": "prisma db migrate",
		"dbi:verify": "prisma db verify",
		"lint": "biome check src",
		"format": "biome check --write src",
		"build": "bun build src/index.ts --target=bun --outdir=dist",
		"postinstall": "prisma skills sync || exit 0",
		"contract:emit": "prisma contract emit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@hono/node-server": "^2.1.1",
		"@prisma/cli-engine": "0.4.0",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.2",
		"husky": "^9.1.7",
		"prisma": "^8.0.0-rc.15"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@nodewave/prisma-ezfilter": "^0.2.1",
		"@prisma/client": "^7.10.0",
		"@prisma/orm-postgres": "^8.0.0-rc.11",
		"@scalar/hono-api-reference": "^0.12.5",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.3",
		"hono": "^4.13.9",
		"jsonwebtoken": "^9.0.3",
		"temporal-polyfill": "^1.0.5",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": "22.x"
	}
}
